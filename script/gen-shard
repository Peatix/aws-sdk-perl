#!/usr/bin/env perl

# gen-shard: regenerate Paws auto-lib classes for one named shard of
# services.
#
# Mirrors script/test-shard. The CI `build-autolib` stage fans the
# generator across a strategy matrix; each cell runs one shard via
#   make gen-shard SHARD=<name>
# Splitting generator work across shards cuts the cache-miss wall
# time of the test workflow from ~28 min (single job, 4-core
# Parallel::ForkManager bound) to ~5-7 min (M shards x 4 cores) plus
# a small merge job that runs --paws_pm over the full service set.
#
# Usage:
#   script/gen-shard SHARD              # run the shard
#   script/gen-shard --list             # list shard names
#   script/gen-shard --files SHARD      # list service-2.json files in shard
#   script/gen-shard --plan             # show all shards + per-shard
#                                       # service count and byte total
#                                       # (for re-balancing)
#   script/gen-shard --verify           # assert union of shards equals
#                                       # the canonical input set
#                                       # (Paws::API::Builder::Paws's
#                                       # boto_file_information)
#
# Partitioning algorithm:
#
#   Largest-first greedy bin-packing on file size. Sort all
#   service-2.json files (latest version per service, skip-list
#   applied) descending by byte size. For each file in turn, drop it
#   into the shard with the smallest cumulative byte total so far
#   (ties broken alphabetically by shard name). Output is
#   deterministic given the same input set, so adjacent CI runs and
#   local dev runs produce the same partition.
#
#   File size is a usable proxy for generator wall time per service:
#   most service-2.json bytes are shape definitions, and the
#   per-shape templates dominate runtime. Counts of generated .pm
#   files per service track byte-size closely (EC2 ~2100 .pm /
#   3.4 MB, SageMaker ~1300 .pm / 2.0 MB, ...).
#
# Why dynamic by-size, not a hardcoded shard-to-services list:
#
#   New services land via .github/workflows/generate-and-pr.yml when
#   share/botocore/.upstream-sha rolls forward. A hardcoded list
#   would go stale silently and need manual maintenance every time
#   the upstream pin moves. Dynamic by-size stays balanced as long
#   as the size proxy holds.
#
# Determinism note (regen-byte-identical workflow):
#
#   The shard + merge pipeline produces the same auto-lib bytes as a
#   single `make gen-classes-no-doc-fetch` run because:
#     - --classes processes services independently; the per-service
#       output depends only on the service-2.json + templates +
#       builder code, not on which other services share the run.
#     - --paws_pm runs once at merge time over the full
#       boto_file_information set (NOT a per-shard slice), so the
#       master service index sees the complete list.
#     - Each shard nukes auto-lib/Paws/* before generating, so no
#       stale per-service state from previous runs leaks in.

use strict;
use warnings;
use v5.20;

use Cwd;
use File::Spec;
use FindBin qw($Bin);
use Getopt::Long qw(:config posix_default no_ignore_case bundling);

# Adding / removing shards is a single-line change here. M=6 chosen
# to put the worst-case shard wall time comfortably under the
# remaining budget after plan + merge overhead. See the PR that
# introduced this script for the math.
my @ALL_SHARDS  = qw(a b c d e f);
my %SHARD_INDEX = map { $ALL_SHARDS[$_] => $_ } 0 .. $#ALL_SHARDS;

my $list_shards = 0;
my $files_only  = 0;
my $plan        = 0;
my $verify      = 0;
my $help        = 0;
my $docu        = 0;

GetOptions(
    'list'   => \$list_shards,
    'files'  => \$files_only,
    'plan'   => \$plan,
    'verify' => \$verify,
    'docu'   => \$docu,
    'help|h' => \$help,
) or die "invalid arguments; try --help\n";

if ($help) {
    print <<'USAGE';
gen-shard: regenerate Paws auto-lib classes for one named shard.

usage:
  script/gen-shard SHARD              run the shard via gen_classes.pl
  script/gen-shard --list             list shard names
  script/gen-shard --files SHARD      list service-2.json files in shard
  script/gen-shard --plan             show shards + cumulative-byte totals
  script/gen-shard --verify           assert union of shards covers
                                      Paws::API::Builder::Paws's full set

options:
  --docu                              also emit documentation files
                                      (--docu_links). Off by default
                                      because it fetches URLs over HTTP.
USAGE
    exit 0;
}

# --list doesn't need to load the builder: the shard set is
# compile-time. Useful for shell completions and CI debug.
if ($list_shards) {
    print "$_\n" for @ALL_SHARDS;
    exit 0;
}

my $repo_root = File::Spec->rel2abs(File::Spec->catdir($Bin, File::Spec->updir));
chdir $repo_root or die "chdir $repo_root: $!\n";

require lib;
lib->import('builder-lib');
require Paws::API::Builder::Paws;

my $builder = Paws::API::Builder::Paws->new(
    template_path => [ getcwd() . '/templates' ],
);

# boto_file_information honours service_skip_list. Pull `file` (the
# service-2.json path) from each entry; this is what gen_classes.pl
# accepts as @ARGV.
my @files;
{
    my $info = $builder->boto_file_information;
    for my $service (sort keys %$info) {
        push @files, $info->{$service}{file};
    }
}
die "no service-2.json files visible to builder\n" if !@files;

my @sized = map { { file => $_, size => -s $_ // 0 } } @files;
@sized = sort {
    $b->{size} <=> $a->{size} || $a->{file} cmp $b->{file}
} @sized;

my %shard_files = map { $_ => [] } @ALL_SHARDS;
my %shard_sum   = map { $_ => 0  } @ALL_SHARDS;
for my $entry (@sized) {
    my @candidates = sort {
        $shard_sum{$a} <=> $shard_sum{$b}
        || $SHARD_INDEX{$a} <=> $SHARD_INDEX{$b}
    } @ALL_SHARDS;
    my $target = $candidates[0];
    push @{$shard_files{$target}}, $entry->{file};
    $shard_sum{$target} += $entry->{size};
}

# Sort each shard's file list lexicographically for deterministic
# output (otherwise the LFRR insertion order leaks into the listing).
for my $shard (@ALL_SHARDS) {
    @{$shard_files{$shard}} = sort @{$shard_files{$shard}};
}

if ($plan) {
    for my $shard (@ALL_SHARDS) {
        printf "shard=%s services=%d bytes=%d\n",
            $shard, scalar @{$shard_files{$shard}}, $shard_sum{$shard};
    }
    exit 0;
}

if ($verify) {
    my %seen;
    for my $shard (@ALL_SHARDS) {
        for my $f (@{$shard_files{$shard}}) {
            if ($seen{$f}++) {
                die "FAIL: $f appears in more than one shard\n";
            }
        }
    }
    my %expected = map { $_ => 1 } @files;
    my @missing = grep { !$seen{$_} }     sort keys %expected;
    my @extra   = grep { !$expected{$_} } sort keys %seen;
    if (@missing || @extra) {
        die sprintf(
            "FAIL: %d missing, %d extra\nmissing:\n%s\nextra:\n%s\n",
            scalar @missing, scalar @extra,
            join("\n", map { "  $_" } @missing),
            join("\n", map { "  $_" } @extra),
        );
    }
    printf "ok: %d service-2.json files covered by %d shards\n",
        scalar @files, scalar @ALL_SHARDS;
    exit 0;
}

my $shard_name = shift @ARGV;
die "no SHARD; try --help\n" if !defined $shard_name;
die "unknown shard '$shard_name'; try --list\n"
    if !exists $shard_files{$shard_name};

my @shard_paths = @{$shard_files{$shard_name}};

if ($files_only) {
    print "$_\n" for @shard_paths;
    exit 0;
}

# Run the shard: invoke gen_classes.pl --classes <files> with this
# shard's slice. No --paws_pm — that needs the full set on disk and
# runs once in the merge job after all shard outputs are assembled.
my $gen_classes
    = File::Spec->catfile($repo_root, qw(builder-bin gen_classes.pl));
die "gen_classes.pl missing or not executable: $gen_classes\n"
    if !-x $gen_classes;

my @cmd = (
    $^X, '-I', File::Spec->catdir($repo_root, 'builder-lib'), $gen_classes,
);
push @cmd, '--classes';
push @cmd, '--docu_links' if $docu;
push @cmd, @shard_paths;

printf STDERR
    "running shard '%s' (%d services, %d bytes): %s --classes <%d files>\n",
    $shard_name, scalar @shard_paths, $shard_sum{$shard_name},
    $cmd[3], scalar @shard_paths;

my $rc = system { $cmd[0] } @cmd;
exit($rc == 0 ? 0 : 1);
