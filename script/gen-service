#!/usr/bin/env perl

# gen-service: regenerate the Paws classes for one or more AWS services.
#
# Useful for fast iteration on the generator, templates, or per-service
# tweaks: avoids the multi-minute full `make gen-classes` run that would
# otherwise rebuild every service.
#
# Usage:
#   script/gen-service SERVICE [SERVICE...]
#   script/gen-service --list
#   script/gen-service --help
#
# SERVICE can be:
#   - A botocore service directory name (e.g. sqs, acm-pca, cognito-idp)
#   - A path to a service-2.json file (passed through as-is)
#   - A Paws class name (e.g. SQS, ACMPCA, CognitoIdp), resolved via the
#     servicefile_to_class_overrides table in
#     builder-lib/Paws/API/Builder/Paws.pm
#
# Output:
#   - auto-lib/Paws/<Service>.pm (top-level service class)
#   - auto-lib/Paws/<Service>/*.pm (operation + shape classes)
#
# Notes:
#   - This does NOT regenerate auto-lib/Paws.pm (the master service
#     index) because that needs the full botocore service set as input.
#     Run `make gen-classes` (or `make gen-classes-no-doc-fetch`) when
#     you need a fresh Paws.pm.
#   - Documentation files (--docu_links) are skipped because they fetch
#     URLs over HTTP. Pass --docu to opt back in.

use strict;
use warnings;
use v5.20;

use Getopt::Long qw(:config posix_default no_ignore_case bundling);
use File::Basename qw(basename);
use File::Spec;
use FindBin qw($Bin);

my $list = 0;
my $help = 0;
my $docu = 0;

GetOptions(
    'list'   => \$list,
    'help|h' => \$help,
    'docu'   => \$docu,
) or die "invalid arguments; try --help\n";

if ($help) {
    print <<'USAGE';
gen-service: regenerate Paws classes for a single AWS service.

usage: script/gen-service SERVICE [SERVICE...]
       script/gen-service --list
       script/gen-service --help

SERVICE can be:
  - A botocore service directory name (e.g. sqs, acm-pca)
  - A path to a service-2.json file
  - A Paws class name (e.g. SQS, ACMPCA, CognitoIdp)

Options:
  --list   Print the resolved botocore directory + service-2.json file
           for every SERVICE argument and exit (no generation).
  --docu   Also regenerate documentation files (--docu_links). Off by
           default because it fetches URLs over HTTP.

Common examples:
  script/gen-service SQS
  script/gen-service sqs s3 ec2
  script/gen-service botocore/botocore/data/sqs/2012-11-05/service-2.json
USAGE
    exit 0;
}

if (!@ARGV) {
    die "no SERVICE arguments; try --help\n";
}

my $repo_root = File::Spec->rel2abs(File::Spec->catdir($Bin, File::Spec->updir));

my $botocore_data = File::Spec->catdir($repo_root, qw(botocore botocore data));
if (!-d $botocore_data) {
    die "botocore data dir not found at $botocore_data; did you run `git submodule update --init`?\n";
}

my $class_to_dir = build_class_to_dir_map($repo_root);
my $botocore_dirs = list_botocore_service_dirs($botocore_data);

my @resolved;
for my $arg (@ARGV) {
    push @resolved, resolve_service_arg($arg, $botocore_data, $class_to_dir, $botocore_dirs);
}

if ($list) {
    for my $r (@resolved) {
        printf "%s\t%s\n", $r->{service_dir}, $r->{file};
    }
    exit 0;
}

# gen_classes.pl is the canonical entry point. Reuse it so this script
# stays a thin wrapper rather than diverging.
my $gen_classes = File::Spec->catfile($repo_root, qw(builder-bin gen_classes.pl));
if (!-x $gen_classes) {
    die "gen_classes.pl not found or not executable at $gen_classes\n";
}

my @cmd = ($^X, '-I', File::Spec->catdir($repo_root, 'builder-lib'), $gen_classes);
push @cmd, '--classes';
push @cmd, '--docu_links' if $docu;
push @cmd, map { $_->{file} } @resolved;

print "running: ", join(' ', @cmd), "\n";
my $rc = system { $cmd[0] } @cmd;
exit($rc == 0 ? 0 : 1);

sub resolve_service_arg {
    my ($arg, $botocore_data, $class_to_dir, $botocore_dirs) = @_;

    if ($arg =~ m{/} || $arg =~ m{\.json$}) {
        if (!-r $arg) {
            die "service-2.json not readable: $arg\n";
        }
        my @parts = File::Spec->splitdir($arg);
        my $service_dir;
        for my $i (0 .. $#parts) {
            if ($parts[$i] eq 'data' && $i + 2 <= $#parts) {
                $service_dir = $parts[$i + 1];
                last;
            }
        }
        $service_dir //= basename(File::Spec->catdir(File::Spec->splitdir($arg)));
        return { service_dir => $service_dir, file => $arg };
    }

    # Class-name override (case-sensitive, e.g. SQS -> sqs, CognitoIdp -> cognito-idp).
    if (my $service_dir = $class_to_dir->{$arg}) {
        my $cdir = File::Spec->catdir($botocore_data, $service_dir);
        my $latest = latest_service_2_json($cdir);
        die "no service-2.json under $cdir for class $arg\n" if !$latest;
        return { service_dir => $service_dir, file => $latest };
    }

    # Botocore dir name (case-sensitive against the actual directory listing
    # so we don't get fooled by macOS / Windows case-insensitive lookups).
    if ($botocore_dirs->{$arg}) {
        my $cdir = File::Spec->catdir($botocore_data, $arg);
        my $latest = latest_service_2_json($cdir);
        die "no service-2.json under $cdir\n" if !$latest;
        return { service_dir => $arg, file => $latest };
    }

    # Fall back to lowercase directory, useful for callers that pass a
    # rough Paws class name that happens to lowercase to the botocore dir
    # (e.g. SQS -> sqs, S3 -> s3).
    my $lc = lc $arg;
    if ($botocore_dirs->{$lc}) {
        my $cdir = File::Spec->catdir($botocore_data, $lc);
        my $latest = latest_service_2_json($cdir);
        die "no service-2.json under $cdir\n" if !$latest;
        return { service_dir => $lc, file => $latest };
    }

    die "could not resolve SERVICE='$arg'.\n"
      . "Tried:\n"
      . "  - path/JSON file: $arg\n"
      . "  - class override: " . ($class_to_dir->{$arg} || "(no match)") . "\n"
      . "  - botocore dir:   $arg\n"
      . "  - lowercased dir: $lc\n"
      . "Run `script/gen-service --list <SERVICE>` to confirm resolution,\n"
      . "or pass an explicit service-2.json path.\n";
}

sub latest_service_2_json {
    my ($dir) = @_;
    return undef if !-d $dir;
    my @files = sort glob File::Spec->catfile($dir, '*', 'service-2.json');
    return undef if !@files;
    return $files[-1];
}

sub list_botocore_service_dirs {
    my ($botocore_data) = @_;
    opendir my $dh, $botocore_data or die "opendir $botocore_data: $!\n";
    my %dirs;
    while (my $entry = readdir $dh) {
        next if $entry =~ /^\./;
        my $full = File::Spec->catdir($botocore_data, $entry);
        next if !-d $full;
        $dirs{$entry} = 1;
    }
    closedir $dh;
    return \%dirs;
}

sub build_class_to_dir_map {
    my ($repo_root) = @_;
    my $builder_pm = File::Spec->catfile($repo_root, qw(builder-lib Paws API Builder Paws.pm));
    if (!-r $builder_pm) {
        warn "could not read $builder_pm; class-name resolution disabled\n";
        return {};
    }
    open my $fh, '<', $builder_pm or do {
        warn "open $builder_pm: $!; class-name resolution disabled\n";
        return {};
    };
    my $content = do { local $/; <$fh> };
    close $fh;

    # Parse entries of the form `KEY => VALUE,` from inside the
    # servicefile_to_class_overrides hash literal. Both KEY and VALUE
    # may be either a quoted string or a bareword. Loose on purpose:
    # the table grows over time and we just need to invert it for
    # SERVICE -> botocore-dir lookups.
    my ($block) = $content =~ /servicefile_to_class_overrides\b.*?sub\s*\{\s*\{(.*?)\}\s*\}\s*\)\s*;/s;
    return {} if !defined $block;

    my %map;
    while ($block =~ /
        (?:'([^']+)' | "([^"]+)" | ([A-Za-z_][\w-]*))  # KEY
        \s* => \s*
        (?:'([^']+)' | "([^"]+)" | ([A-Za-z_][\w-]*))  # VALUE
        \s* ,
    /gx) {
        my $key = defined $1 ? $1 : defined $2 ? $2 : $3;
        my $val = defined $4 ? $4 : defined $5 ? $5 : $6;
        next if !defined $key || !defined $val;
        $map{$val} = $key;
    }
    return \%map;
}
