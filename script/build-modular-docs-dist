#!/usr/bin/env perl
# build-modular-docs-dist <Service>
#
# Phase 1.5 of the A4-B distribution plan
# (docs/distribution-plan-a4b.md §3.2). Produces a
# `Paws-<Service>-Docs-<version>.tar.gz` companion to the code dist
# generated by `script/build-modular-dist`.
#
# Drives Materializer::Moo->generate_pod_for_service($ir) and writes
# each returned (Paws::Foo::Bar => $pod_str) entry to
# lib/Paws/<Service>/<Op|Shape>.pod at the canonical class path. With
# the docs companion installed alongside the code dist, `perldoc
# Paws::S3::CreateBucket` resolves to the .pod file (Perl's
# perldoc searches @INC for <class>.pod and <class>.pm).
#
# Inputs:
#   $ARGV[0]                  - Paws service class name (e.g. S3)
#   --output-dir <dir>        - default "dist/docs/"
#   --version <ver>           - default reads from lib/Paws.pm

use strict;
use warnings;
use v5.10;

use FindBin;
use lib "$FindBin::Bin/../lib";

use Getopt::Long;
use File::Path qw(make_path remove_tree);
use File::Spec;
use File::Slurper qw(write_text read_text);
use File::Basename qw(dirname);

use Paws::Model::Loader::Resolver;
use Paws::Model::Materializer::Moo;

my $output_dir = 'dist/docs';
my $version;

GetOptions(
    'output-dir=s' => \$output_dir,
    'version=s'    => \$version,
) or die "bad args\n";

my $service = shift @ARGV;
defined($service) && length($service)
    or die "usage: $0 [--output-dir DIR] [--version VER] <Service>\n";

if (!defined $version) {
    my $paws_pm = read_text("$FindBin::Bin/../lib/Paws.pm");
    if ($paws_pm =~ /our\s+\$VERSION\s*=\s*'([^']+)'/) {
        $version = $1;
    } else {
        die "could not extract version from lib/Paws.pm\n";
    }
}

my $resolver = Paws::Model::Loader::Resolver->new;
my $ir = eval { $resolver->load_service($service) };
$ir or die "build-modular-docs-dist: resolver could not find IR for $service: $@";

# Mirror the name normalisation used by build-modular-dist /
# Materializer::Auto so package names land at "Paws::SecretsManager"
# rather than "Paws::Secrets Manager".
if ($service ne $ir->name) {
    $ir->{name} = $service;
}

my $service_pkg = "Paws::$service";

my $dist_name = "Paws-$service-Docs";
my $tmp_root  = "tmp/build/$dist_name";
remove_tree($tmp_root) if -d $tmp_root;
make_path($tmp_root);

my $mat = Paws::Model::Materializer::Moo->new(loader => undef);
my $pod_by_pkg = $mat->generate_pod_for_service($ir);

my @pod_rel_paths;
for my $pkg (sort keys %$pod_by_pkg) {
    next unless $pkg =~ /^\Q$service_pkg\E(?:::|\z)/;
    my $rel = $pkg;
    $rel =~ s{::}{/}g;
    $rel .= '.pod';
    my $abs = "$tmp_root/lib/$rel";
    make_path(dirname($abs));
    write_text($abs, $pod_by_pkg->{$pkg});
    push @pod_rel_paths, "lib/$rel";
}

print STDERR "build-modular-docs-dist svc=$service pod_files=" . scalar(@pod_rel_paths) . "\n";

# Generated dist files.
write_text("$tmp_root/dist.ini", <<EOT);
name             = $dist_name
version          = $version
author           = Peatix Paws maintainers
license          = Apache_2_0
copyright_holder = Jose Luis Martinez and Peatix Paws maintainers
copyright_year   = 2014

[GatherDir]
[ModuleBuildTiny::Fallback]
[Manifest]
EOT

write_text("$tmp_root/cpanfile", <<EOT);
requires 'perl' => '5.012001';
requires 'Paws::$service' => '>= $version';
EOT

my @manifest = sort
    ('cpanfile', 'dist.ini', 'META.yml', 'Build.PL', 'Makefile.PL',
     'MANIFEST', @pod_rel_paths);
write_text("$tmp_root/MANIFEST", join("\n", @manifest) . "\n");

# Provides line: list every .pod file as a no-version provider so
# CPAN clients can resolve `Paws::S3::CreateBucket` to this dist when
# the user has explicitly cpanm-installed the docs companion.
my @provides_lines;
for my $pkg (sort keys %$pod_by_pkg) {
    next unless $pkg =~ /^\Q$service_pkg\E(?:::|\z)/;
    my $rel = $pkg; $rel =~ s{::}{/}g;
    push @provides_lines,
        "  $pkg:",
        "    file: lib/$rel.pod",
        "    version: $version";
}
my $provides = join("\n", @provides_lines);

write_text("$tmp_root/META.yml", <<EOT);
---
abstract: 'Modular AWS SDK: $service_pkg POD documentation companion'
author:
  - 'Peatix Paws maintainers'
configure_requires:
  Module::Build::Tiny: '0.034'
build_requires:
  Module::Build::Tiny: '0.034'
dynamic_config: 0
generated_by: 'script/build-modular-docs-dist'
license: apache_2_0
meta-spec:
  url: http://module-build.sourceforge.net/META-spec-v1.4.html
  version: '1.4'
name: $dist_name
provides:
$provides
requires:
  Paws::$service: '$version'
  perl: '5.012001'
version: '$version'
EOT

write_text("$tmp_root/Build.PL", <<'EOT');
use strict;
use warnings;
use Module::Build::Tiny 0.034;
Build_PL();
EOT

write_text("$tmp_root/Makefile.PL", <<'EOT');
require Module::Build::Tiny;
Module::Build::Tiny::Build_PL();
EOT

# Tarball.
make_path($output_dir);
my $tarball = File::Spec->catfile($output_dir, "$dist_name-$version.tar.gz");
unlink $tarball if -e $tarball;

my $epoch = $ENV{SOURCE_DATE_EPOCH} // 0;
require File::Find;
File::Find::find(sub {
    utime $epoch, $epoch, $_ if -e $_;
}, $tmp_root);

my $stage = "tmp/build/$dist_name-$version";
remove_tree($stage) if -d $stage;
rename($tmp_root, $stage) or die "rename($tmp_root, $stage): $!";
File::Find::find(sub {
    utime $epoch, $epoch, $_ if -e $_;
}, $stage);

my $rc = system('tar', '--create', '--gzip', '--file', $tarball,
                '--directory', 'tmp/build', "$dist_name-$version");
$rc == 0 or die "tar exited with rc=$rc\n";

print STDERR "build-modular-docs-dist svc=$service tarball=$tarball bytes=" . (-s $tarball) . "\n";
print "$tarball\n";
