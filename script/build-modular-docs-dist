#!/usr/bin/env perl
# build-modular-docs-dist <Service>
#
# Phase 1 of the A4-B distribution plan
# (docs/distribution-plan-a4b.md §3.2). Produces a
# `Paws-<Service>-Docs-<version>.tar.gz` companion to the
# code dist generated by `script/build-modular-dist`.
#
# IMPLEMENTATION STATUS (Phase 1):
#
# This script ships a STUB docs dist: a single `lib/Paws/<Service>.pod`
# file with a placeholder POD listing the operations. Full per-shape /
# per-operation POD generation is deferred to Phase 1.5: it requires
# Materializer::Moo to learn POD-emission templates (the `pod => 1`
# constructor flag from plan §3.1 step 4). The stub is enough to
# validate the dist-shape, install, and the `Recommends`/companion-
# install ergonomic; full content lands once the materialiser POD
# templates do.
#
# Inputs:
#   $ARGV[0]                  - Paws service class name (e.g. S3)
#   --output-dir <dir>        - default "dist/docs/"
#   --version <ver>           - default reads from lib/Paws.pm

use strict;
use warnings;
use v5.10;

use FindBin;
use lib "$FindBin::Bin/../lib";

use Getopt::Long;
use File::Path qw(make_path remove_tree);
use File::Spec;
use File::Slurper qw(write_text read_text);

use Paws::Model::Loader::Resolver;

my $output_dir = 'dist/docs';
my $version;

GetOptions(
    'output-dir=s' => \$output_dir,
    'version=s'    => \$version,
) or die "bad args\n";

my $service = shift @ARGV;
defined($service) && length($service)
    or die "usage: $0 [--output-dir DIR] [--version VER] <Service>\n";

if (!defined $version) {
    my $paws_pm = read_text("$FindBin::Bin/../lib/Paws.pm");
    if ($paws_pm =~ /our\s+\$VERSION\s*=\s*'([^']+)'/) {
        $version = $1;
    } else {
        die "could not extract version from lib/Paws.pm\n";
    }
}

my $resolver = Paws::Model::Loader::Resolver->new;
my $ir = eval { $resolver->load_service($service) };
$ir or die "build-modular-docs-dist: resolver could not find IR for $service: $@";

my @op_names = $ir->operation_names;

my $dist_name = "Paws-$service-Docs";
my $tmp_root  = "tmp/build/$dist_name";
remove_tree($tmp_root) if -d $tmp_root;
make_path("$tmp_root/lib/Paws/$service");

my $service_pkg = "Paws::$service";

# Stub POD - top-level entry that lists the operations.
my $stub_pod = <<"EOT";
=encoding utf-8

=head1 NAME

$service_pkg - AWS $service service documentation

=head1 STATUS

This is a Phase 1 stub. The full per-operation POD ships in Phase 1.5
when Paws::Model::Materializer::Moo learns POD-emission templates
(see docs/distribution-plan-a4b.md §3.1 step 4).

=head1 OPERATIONS

The companion code dist (\`$service_pkg\`) provides these operations:

=over 4
EOT

for my $op (sort @op_names) {
    $stub_pod .= "\n=item *\n\nC<< \$svc->$op(...) >>";
}

$stub_pod .= <<"EOT";

=back

=head1 SEE ALSO

L<$service_pkg> - the code dist this companion documents.

L<https://docs.aws.amazon.com/> - canonical AWS service documentation.

=cut
EOT

write_text("$tmp_root/lib/Paws/$service.pod", $stub_pod);

# Generated dist files.
write_text("$tmp_root/dist.ini", <<EOT);
name             = $dist_name
version          = $version
author           = Peatix Paws maintainers
license          = Apache_2_0
copyright_holder = Jose Luis Martinez and Peatix Paws maintainers
copyright_year   = 2014

[GatherDir]
[ModuleBuildTiny::Fallback]
[Manifest]
EOT

write_text("$tmp_root/cpanfile", <<EOT);
requires 'perl' => '5.012001';
requires 'Paws::$service' => '>= $version';
EOT

my @manifest = sort
    ('cpanfile', 'dist.ini', 'META.yml', 'Build.PL', 'Makefile.PL',
     'MANIFEST', "lib/Paws/$service.pod");
write_text("$tmp_root/MANIFEST", join("\n", @manifest) . "\n");

write_text("$tmp_root/META.yml", <<EOT);
---
abstract: 'Modular AWS SDK: $service_pkg POD documentation companion (Phase 1 stub)'
author:
  - 'Peatix Paws maintainers'
configure_requires:
  Module::Build::Tiny: '0.034'
build_requires:
  Module::Build::Tiny: '0.034'
dynamic_config: 0
generated_by: 'script/build-modular-docs-dist'
license: apache_2_0
meta-spec:
  url: http://module-build.sourceforge.net/META-spec-v1.4.html
  version: '1.4'
name: $dist_name
requires:
  Paws::$service: '$version'
  perl: '5.012001'
version: '$version'
EOT

write_text("$tmp_root/Build.PL", <<'EOT');
use strict;
use warnings;
use Module::Build::Tiny 0.034;
Build_PL();
EOT

write_text("$tmp_root/Makefile.PL", <<'EOT');
require Module::Build::Tiny;
Module::Build::Tiny::Build_PL();
EOT

# Tarball.
make_path($output_dir);
my $tarball = File::Spec->catfile($output_dir, "$dist_name-$version.tar.gz");
unlink $tarball if -e $tarball;

my $epoch = $ENV{SOURCE_DATE_EPOCH} // 0;
require File::Find;
File::Find::find(sub {
    utime $epoch, $epoch, $_ if -e $_;
}, $tmp_root);

my $stage = "tmp/build/$dist_name-$version";
remove_tree($stage) if -d $stage;
make_path($stage);
require File::Copy::Recursive;
File::Copy::Recursive::dircopy($tmp_root, $stage)
    or die "stage dircopy failed: $!";
File::Find::find(sub {
    utime $epoch, $epoch, $_ if -e $_;
}, $stage);

my $rc = system('tar', '--create', '--gzip', '--file', $tarball,
                '--directory', 'tmp/build', "$dist_name-$version");
$rc == 0 or die "tar exited with rc=$rc\n";

print STDERR "build-modular-docs-dist svc=$service tarball=$tarball bytes=" . (-s $tarball) . "\n";
print "$tarball\n";
