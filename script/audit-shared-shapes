#!/usr/bin/env perl
# audit-shared-shapes
#
# Phase 1 cross-service shared-shape audit per A4-B plan §7.
# For a list of services whose code dists have already been built
# under tmp/build/Paws-<svc>-<ver>/, count distinct shape names
# referenced by ≥2 services and the total KB cost of duplicating
# them.
#
# Default policy is always-duplicate per maintainer decision.
# This audit produces the data the maintainer needs to revisit if
# duplication scale turns out to be material.

use strict;
use warnings;
use v5.10;

use Getopt::Long;
use File::Find;
use File::Spec;

my $build_dir = 'tmp/build';
my @services_arg;
my $top = 20;

GetOptions(
    'build-dir=s' => \$build_dir,
    'services=s'  => \@services_arg,
    'top=i'       => \$top,
) or die "bad args\n";

@services_arg = split(/,/, join(',', @services_arg));
@services_arg or die "usage: $0 --services A,B,C [--build-dir DIR] [--top N]\n";

# Map shape name -> { services-that-emit-it -> bytes }
my %by_shape;
my %total_bytes_by_service;
my $total_pkg_count = 0;

for my $svc (@services_arg) {
    # Find the most-recent versioned dir under tmp/build/.
    my @dirs = sort glob "$build_dir/Paws-$svc-*";
    if (!@dirs) {
        warn "audit-shared-shapes: no build for $svc under $build_dir\n";
        next;
    }
    my $svc_dir = $dirs[-1];
    my $lib_dir = File::Spec->catdir($svc_dir, 'lib', 'Paws', $svc);
    if (!-d $lib_dir) {
        warn "audit-shared-shapes: no lib/Paws/$svc under $svc_dir\n";
        next;
    }

    File::Find::find({
        wanted => sub {
            return unless -f $_;
            return unless /\.pm$/;
            my $rel = $File::Find::name;
            $rel =~ s/^\Q$lib_dir\E\///;
            $rel =~ s/\.pm$//;
            my @parts = split m{/}, $rel;
            my $shape_name = $parts[-1];

            my $bytes = -s $_;
            return unless defined $bytes;
            $by_shape{$shape_name}{$svc} += $bytes;
            $total_bytes_by_service{$svc} += $bytes;
            $total_pkg_count++;
        },
        no_chdir => 0,
    }, $lib_dir);
}

my @shared = grep { scalar(keys %{ $by_shape{$_} }) >= 2 } keys %by_shape;
my $total_shared_bytes = 0;
for my $s (@shared) {
    for my $svc (keys %{ $by_shape{$s} }) {
        $total_shared_bytes += $by_shape{$s}{$svc};
    }
}

# Per-shape duplication "cost" = total bytes - bytes-of-the-largest-occurrence
# (i.e. the bytes that would be saved if we extracted the shape to
# a single shared dist; an upper bound because the de-duped version
# would still need a small wrapper class per service).
my %dupe_cost;
for my $s (@shared) {
    my @sizes = sort { $a <=> $b } values %{ $by_shape{$s} };
    my $sum = 0; $sum += $_ for @sizes;
    $dupe_cost{$s} = $sum - $sizes[-1];
}

my $total_dupe_cost = 0;
$total_dupe_cost += $_ for values %dupe_cost;

printf "audit-shared-shapes services=%d total_packages=%d distinct_shapes=%d shared_shape_count=%d\n",
    scalar(@services_arg), $total_pkg_count, scalar(keys %by_shape), scalar(@shared);
printf "audit-shared-shapes total_shared_bytes=%d (%.1f KB) total_dupe_cost_bytes=%d (%.1f KB)\n",
    $total_shared_bytes, $total_shared_bytes / 1024,
    $total_dupe_cost,    $total_dupe_cost    / 1024;
my $total_install_bytes = sum_values(\%total_bytes_by_service) || 1;
printf "audit-shared-shapes total_install_bytes=%d (%.1f KB) dupe_share_pct=%.1f%%\n",
    $total_install_bytes,
    $total_install_bytes / 1024,
    100 * $total_dupe_cost / $total_install_bytes;

# Top-N most-duplicated shapes by dupe-cost.
my @sorted_shared = sort { $dupe_cost{$b} <=> $dupe_cost{$a} } @shared;
print "\ntop $top shared shapes by duplication-cost (bytes):\n";
print "shape\tservices\ttotal_bytes\tdupe_cost_bytes\n";
for my $s (@sorted_shared[0 .. ($top - 1 < $#sorted_shared ? $top - 1 : $#sorted_shared)]) {
    my @svcs = sort keys %{ $by_shape{$s} };
    my $total = 0;
    $total += $_ for values %{ $by_shape{$s} };
    printf "%s\t%s\t%d\t%d\n",
        $s, join(',', @svcs), $total, $dupe_cost{$s};
}

sub sum_values {
    my ($hr) = @_;
    my $s = 0;
    $s += $_ for values %$hr;
    return $s;
}
