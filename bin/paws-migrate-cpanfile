#!/usr/bin/env perl
# paws-migrate-cpanfile - emit a cpanfile snippet pinning the
#                        per-service modular Paws sub-dists a project
#                        actually uses.
#
# Usage:
#   bin/paws-migrate-cpanfile [--root DIR] [--version VER] [--base URL]
#                             [--output FILE]
#                             [--include-paws-bin]
#
# Walks the source tree under --root (default: cwd), greps Perl
# source files for `Paws->service('<Name>')` and `Paws->load_class
# ('Paws::<Name>')` references, and emits a cpanfile snippet to
# stdout (or --output) with one `requires` line per unique service.
#
# Defaults to v1.0.0; pin via --version <ver>.
#
# Phase 4 of the A4-B distribution plan
# (docs/distribution-plan-a4b.md §5).
#
# The script is deliberately conservative: it matches string-literal
# service names only. Projects with dynamic dispatch (e.g.
# `Paws->service($svc)`) need to add the service set by hand.

use strict;
use warnings;
use v5.10;

use File::Find;
use Getopt::Long;

my $root            = '.';
my $version         = '1.0.0';
my $base            = 'https://github.com/Peatix/aws-sdk-perl/releases/download';
my $output;
my $include_bin     = 0;
my $include_examples = 0;
my $help;

GetOptions(
    'root=s'              => \$root,
    'version=s'           => \$version,
    'base=s'              => \$base,
    'output=s'            => \$output,
    'include-paws-bin'    => \$include_bin,
    'include-examples'    => \$include_examples,
    'help|h'              => \$help,
) or _usage();

_usage() if $help;

# Walk the tree.
my @perl_files;
File::Find::find({
    no_chdir => 1,
    wanted   => sub {
        return unless -f;
        return unless /\.(?:pl|pm|psgi|t)$/i;
        # Skip common vendor dirs.
        return if m{/(?:local|node_modules|vendor|\.git|\.svn|tmp/build)/};
        push @perl_files, $File::Find::name;
    },
}, $root);

my %services;
for my $f (@perl_files) {
    open my $fh, '<', $f or do {
        warn "skip $f: $!\n";
        next;
    };
    while (my $line = <$fh>) {
        # Paws->service('Foo') and Paws->service("Foo")
        while ($line =~ /Paws->service\s*\(\s*['"]([\w]+)['"]/g) {
            $services{$1}++;
        }
        # Paws->load_class('Paws::Foo') and ::Paws::Foo::Bar
        while ($line =~ /Paws->load_class\s*\(\s*['"]Paws::(\w+)/g) {
            $services{$1}++;
        }
        # use Paws::Foo (excluding Paws::Net, Paws::API, Paws::Credential, etc.)
        while ($line =~ /\buse\s+Paws::(\w+)/g) {
            my $name = $1;
            # Skip Paws::Core internals (the wire layer / IR data
            # classes ship inside Paws-Core; users don't pin sub-dists
            # for them).
            next if $name =~ /^(?:Net|API|Credential|Exception|Model|Signin|SDK|SerDes|Test)$/;
            # Skip the synthetic test-fixture services Paws ships
            # under t/lib/Paws/. They aren't real AWS services and
            # have no Paws-<svc> sub-dist on GH Releases.
            next if $name =~ /^(?:Crawler|EC2ParamsService|GlacierParamsService
                                  |JsonParamsService|QueryParamsService
                                  |QueryFlattenedParamsService
                                  |RestJsonParamsService|RestXmlParamsService)$/x;
            $services{$name}++;
        }
    }
    close $fh;
}

my @found = sort keys %services;

# Emit cpanfile snippet.
my $out_fh = \*STDOUT;
my $opened;
if (defined $output) {
    open $opened, '>', $output or die "open $output: $!";
    $out_fh = $opened;
}

print $out_fh <<"EOT";
# Generated by bin/paws-migrate-cpanfile.
# Phase 4 of the A4-B distribution plan
# (docs/distribution-plan-a4b.md §5). Pinning the per-service modular
# Paws sub-dists this project uses, plus Paws::Core (provides Paws.pm).
#
# Bump \$V on a Paws release; cpanm picks the new tarballs from
# the \$base URL.

my \$V    = '$version';
my \$base = "$base";

requires 'Paws', url => "\$base/v\$V/Paws-Core-\$V.tar.gz";
EOT

if (!@found) {
    print $out_fh <<'EOT';

# WARNING: paws-migrate-cpanfile did not find any
# `Paws->service('X')`, `Paws->load_class('Paws::X')`, or `use Paws::X`
# references in the scanned source tree. Add explicit requires lines
# for the services your project uses.
EOT
} else {
    print $out_fh "\n# Services detected in the source tree:\n";
    for my $svc (@found) {
        printf $out_fh "requires 'Paws::%s', url => \"\$base/v\$V/Paws-%s-\$V.tar.gz\";\n",
            $svc, $svc;
    }
}

close $opened if $opened;

print STDERR "paws-migrate-cpanfile: scanned " . scalar(@perl_files)
    . " Perl files; emitted " . scalar(@found) . " service requires.\n";

sub _usage {
    print STDERR <<'EOT';
Usage: paws-migrate-cpanfile [options]

Options:
  --root DIR           Source tree to scan (default: .)
  --version VER        Paws release version to pin (default: 1.0.0)
  --base URL           GH Releases base URL
                       (default: https://github.com/Peatix/aws-sdk-perl/releases/download)
  --output FILE        Write to FILE instead of stdout
  --help               This message
EOT
    exit 1;
}
