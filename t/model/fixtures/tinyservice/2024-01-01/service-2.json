{
  "version":"2.0",
  "metadata":{
    "apiVersion":"2024-01-01",
    "endpointPrefix":"tinyservice",
    "jsonVersion":"1.1",
    "protocol":"json",
    "serviceFullName":"Tiny Service for Tests",
    "serviceId":"TinyService",
    "signatureVersion":"v4",
    "targetPrefix":"TinyService",
    "uid":"tinyservice-2024-01-01"
  },
  "documentation":"<p>A tiny synthetic service for unit-testing the Botocore loader.</p>",
  "operations":{
    "ListThings":{
      "name":"ListThings",
      "http":{
        "method":"POST",
        "requestUri":"/"
      },
      "input":{"shape":"ListThingsRequest"},
      "output":{"shape":"ListThingsResponse"},
      "errors":[
        {"shape":"ThrottlingException"}
      ],
      "documentation":"<p>List things.</p>"
    },
    "GetThing":{
      "name":"GetThing",
      "http":{
        "method":"GET",
        "requestUri":"/things/{ThingId}"
      },
      "input":{"shape":"GetThingRequest"},
      "output":{"shape":"GetThingResponse"},
      "documentation":"<p>Get one thing.</p>"
    },
    "DeleteThing":{
      "name":"DeleteThing",
      "http":{
        "method":"DELETE",
        "requestUri":"/things/{ThingId}",
        "responseCode":204
      },
      "input":{"shape":"DeleteThingRequest"},
      "deprecated":true,
      "documentation":"<p>Delete a thing.</p>"
    }
  },
  "shapes":{
    "ThingId":{"type":"string"},
    "ThingName":{"type":"string"},
    "ThingCount":{"type":"integer"},
    "Boolean":{"type":"boolean"},
    "Status":{
      "type":"string",
      "enum":["ACTIVE","DISABLED","DELETED"]
    },
    "Thing":{
      "type":"structure",
      "required":["ThingId","ThingName"],
      "members":{
        "ThingId":{"shape":"ThingId"},
        "ThingName":{"shape":"ThingName","locationName":"name"},
        "Status":{"shape":"Status"}
      }
    },
    "ThingList":{
      "type":"list",
      "member":{"shape":"Thing","locationName":"thing"}
    },
    "TagMap":{
      "type":"map",
      "key":{"shape":"ThingName"},
      "value":{"shape":"ThingName"}
    },
    "ListThingsRequest":{
      "type":"structure",
      "members":{
        "Filter":{
          "shape":"ThingName",
          "location":"querystring",
          "locationName":"filter"
        }
      }
    },
    "ListThingsResponse":{
      "type":"structure",
      "members":{
        "Things":{"shape":"ThingList"},
        "Count":{"shape":"ThingCount"}
      }
    },
    "GetThingRequest":{
      "type":"structure",
      "required":["ThingId"],
      "members":{
        "ThingId":{
          "shape":"ThingId",
          "location":"uri",
          "locationName":"ThingId"
        }
      }
    },
    "GetThingResponse":{
      "type":"structure",
      "payload":"Thing",
      "members":{
        "Thing":{"shape":"Thing"}
      }
    },
    "DeleteThingRequest":{
      "type":"structure",
      "required":["ThingId"],
      "members":{
        "ThingId":{
          "shape":"ThingId",
          "location":"uri",
          "locationName":"ThingId"
        },
        "ETag":{
          "shape":"ThingName",
          "location":"header",
          "locationName":"If-Match"
        }
      }
    },
    "ThrottlingException":{
      "type":"structure",
      "members":{
        "Message":{"shape":"ThingName"}
      }
    }
  }
}
